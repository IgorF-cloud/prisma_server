# Modelo do .env do prisma_server. Copie para `.env` e preencha:
#
#   cp .env.example .env
#
# O docker-compose.yml lê este arquivo (env_file) e também usa algumas
# variáveis dele para os outros serviços (Postgres, nginx, ingress).

# --- Servidor -----------------------------------------------------------
# IP público da máquina. Usado pelo livekit-ingress (node_ip) — o mesmo
# valor do whip_base_url no livekit.yaml.
HOST=203.0.113.10
# Porta do Express DENTRO da rede do Compose. Se mudar, mude também a URL
# do webhook no livekit.yaml (http://prisma_server:<PORT>/webhook).
PORT=5000

# --- LiveKit ------------------------------------------------------------
# Precisam ser IGUAIS ao bloco `keys:` do livekit.yaml (aquele arquivo não
# lê o .env; os valores são copiados à mão).
LIVEKIT_API_KEY=prisma
LIVEKIT_API_SECRET=
# Usado pelo backend para falar com a Server API do LiveKit, pela rede
# interna do Compose (nome do serviço, não IP público).
LIVEKIT_SERVER_URL=http://livekit-server:5880

# --- Banco (Postgres) ---------------------------------------------------
# PGHOST é o nome do serviço no docker-compose. O Postgres não publica
# porta no host.
PGHOST=postgres
PGPORT=5432
PGDATABASE=prisma
PGUSER=prisma
PGPASSWORD=

# --- JWT ----------------------------------------------------------------
# Segredo que assina os tokens de login. Gere um aleatório e longo:
#   openssl rand -base64 48
# Trocar invalida todos os logins (todo mundo volta pra tela de login).
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Domínio / HTTPS ----------------------------------------------------
# Domínio principal. O nginx atende DOMAIN, www.DOMAIN e admin.DOMAIN.
DOMAIN=seu-dominio.com
# E-mail para avisos do Let's Encrypt (renovação falhando etc.).
LETSENCRYPT_EMAIL=voce@seu-dominio.com

# --- E-mail (recuperação de senha, via Resend) --------------------------
# SEM a chave, os e-mails são ESCRITOS NO LOG em vez de enviados (modo de
# teste). Em produção isto NÃO pode ficar vazio: quem lê o log consegue
# trocar a senha de qualquer conta.
RESEND_API_KEY=
# Endereço de um domínio verificado no Resend.
MAIL_FROM=Prisma <nao-responda@seu-dominio.com>
